# Public (visible al cliente — para queries via client si las hubiera)
NEXT_PUBLIC_SUPABASE_URL=https://whxufmuakpmuyiatfttr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste your anon key here>

# Server-only (sin prefijo NEXT_PUBLIC_ → NUNCA llega al cliente).
# Usada por Server Components y Route Handlers para leer datos públicos del
# match (matches, groups, sports, users.display_name) sin necesitar abrir
# RLS policies. Pegar la "service_role" key de Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<paste your service_role key here>
