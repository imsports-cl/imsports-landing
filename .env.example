# Public (visible al cliente — para queries via client si las hubiera)
NEXT_PUBLIC_SUPABASE_URL=https://whxufmuakpmuyiatfttr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste your anon key here>

# Server-only (sin prefijo NEXT_PUBLIC_ → NUNCA llega al cliente).
# Usada por Server Components y Route Handlers para leer datos públicos del
# match (matches, groups, sports, users.display_name) sin necesitar abrir
# RLS policies. Pegar la "service_role" key de Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=<paste your service_role key here>

# Server-only. Access Token de PRODUCCIÓN de MercadoPago (APP_USR-...), de la
# app Checkout Pro de Barham. Lo usa SOLO /admin/api/pagos para LEER pagos
# (GET /v1/payments/search y GET /v1/payments/{id}). Nunca con NEXT_PUBLIC_,
# nunca en el repo ni en logs. Sin esta variable la pestaña Pagos muestra los
# titulares sin estado de pago.
MP_ACCESS_TOKEN=<paste your MercadoPago production access token here>

# Apagado por defecto. En 1 o true, el cron y el botón «Aplicar sanciones del cierre»
# escriben la sanción no_pago (y la deuda, si no pagó) al cerrar una pichanga de
# sancion_deuda_grupos. Sin esto no se escribe nada. Requiere la tabla
# public.cierre_sanciones (migración 043 en imsports-app).
SANCIONES_AL_CIERRE=

# Secreto del cron de Vercel. /api/cron/sanciones-cierre exige
# Authorization: Bearer <este valor>. Si falta, la ruta responde 401.
# Nunca lo pongas en el cliente ni en un log.
CRON_SECRET=
